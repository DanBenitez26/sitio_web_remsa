# === Entorno ===
# 'dev' usa SQLite y DEBUG=True. 'prod' usa PostgreSQL y DEBUG=False.
DJANGO_ENV=dev
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-de-forma-segura
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# === Base de datos (solo se usa si DJANGO_ENV=prod) ===
DB_NAME=remsa_web
DB_USER=remsa_user
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# === Correo (SMTP) ===
# En dev, si se deja EMAIL_BACKEND en consola, los correos se imprimen en la terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.tuservidor.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notificaciones@remsaplasticos.com
EMAIL_HOST_PASSWORD=cambia-esta-contrasena
DEFAULT_FROM_EMAIL=REMSA Plásticos <notificaciones@remsaplasticos.com>
COMERCIAL_EMAIL=comercial@remsaplasticos.com
# CAPTCHA opcional: deja ambos vacíos si Google reCAPTCHA no está configurado.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# === Sitio ===
SITE_NAME=REMSA Plásticos
SHOW_WHATSAPP_FLOAT=False
